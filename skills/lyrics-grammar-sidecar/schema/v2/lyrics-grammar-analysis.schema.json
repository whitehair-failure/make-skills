{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakurauta.app/schemas/lyrics-grammar-sidecar/v2.json",
  "title": "SakuraUta Lyrics Grammar Analysis Sidecar v2",
  "description": "A v2-only, read-only grammar analysis sidecar with canonical entities, exact occurrences, and composed block meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "source",
    "lines",
    "repetitionGroups",
    "meaningUnits",
    "blocks",
    "phrases",
    "relations",
    "grammarNotes",
    "uncertainties",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "sakurauta.lyrics-grammar-analysis"
    },
    "schemaVersion": {
      "const": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lrcFile", "songId", "sourceLanguages", "lineCount", "lrcProjectionHash"],
      "properties": {
        "lrcFile": {"type": "string", "minLength": 1, "maxLength": 255},
        "songId": {"type": "string", "minLength": 1},
        "sourceLanguages": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"}
        },
        "lineCount": {"type": "integer", "minimum": 1},
        "lrcProjectionHash": {"$ref": "#/$defs/hash"}
      }
    },
    "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}},
    "repetitionGroups": {
      "type": "array",
      "items": {"$ref": "#/$defs/repetitionGroup"}
    },
    "meaningUnits": {
      "type": "array",
      "items": {"$ref": "#/$defs/meaningUnit"}
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    },
    "phrases": {"type": "array", "items": {"$ref": "#/$defs/phrase"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "grammarNotes": {"type": "array", "items": {"$ref": "#/$defs/grammarNote"}},
    "uncertainties": {"type": "array", "items": {"$ref": "#/$defs/uncertainty"}},
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "required": ["learnerLanguage"],
      "properties": {
        "learnerLanguage": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$"
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9:-]{1,31}$"},
        "key": {"type": "string", "minLength": 1, "maxLength": 64},
        "display": {"type": "string", "maxLength": 120}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineId", "sourceOrder", "timeMs", "text", "fingerprint", "role", "language"],
      "properties": {
        "lineId": {"$ref": "#/$defs/id"},
        "sourceOrder": {"type": "integer", "minimum": 0},
        "timeMs": {"type": "integer", "minimum": 0},
        "endTimeMs": {"type": ["integer", "null"], "minimum": 0},
        "text": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/hash"},
        "role": {"const": "text"},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$"},
        "languageSpans": {"type": "array", "items": {"$ref": "#/$defs/languageSpan"}}
      }
    },
    "languageSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "language"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineId", "start", "end", "text"],
      "properties": {
        "lineId": {"$ref": "#/$defs/id"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "repetitionOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrenceId", "blockId", "sourceSegments"],
      "properties": {
        "occurrenceId": {"$ref": "#/$defs/id"},
        "blockId": {"$ref": "#/$defs/id"},
        "sourceSegments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/segment"}
        }
      }
    },
    "repetitionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitionId", "occurrences"],
      "properties": {
        "repetitionId": {"$ref": "#/$defs/id"},
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/repetitionOccurrence"}
        }
      }
    },
    "meaningOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "text"],
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 240},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "meaningUnitOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrenceId", "blockId", "sourceSegments"],
      "properties": {
        "occurrenceId": {"$ref": "#/$defs/id"},
        "blockId": {"$ref": "#/$defs/id"},
        "sourceSegments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/segment"}
        },
        "semanticOverride": {"$ref": "#/$defs/meaningOverride"}
      }
    },
    "meaningUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaningUnitId", "text", "labels", "confidence", "occurrences"],
      "properties": {
        "meaningUnitId": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/meaningUnitOccurrence"}
        }
      }
    },
    "meaningPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaningUnitOccurrenceId"],
      "properties": {
        "meaningUnitOccurrenceId": {"$ref": "#/$defs/id"},
        "textBefore": {"type": "string", "maxLength": 120}
      }
    },
    "blockMeaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts"],
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/meaningPart"}
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "lineIds", "startTimeMs", "endTimeMs", "meaning", "labels", "confidence"],
      "properties": {
        "blockId": {"$ref": "#/$defs/id"},
        "lineIds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "startTimeMs": {"type": "integer", "minimum": 0},
        "endTimeMs": {"type": "integer", "minimum": 0},
        "meaning": {"$ref": "#/$defs/blockMeaning"},
        "register": {"type": "string", "maxLength": 80},
        "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "notes": {"type": "string"}
      }
    },
    "phraseOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 240},
        "role": {"type": "string", "minLength": 1, "maxLength": 60},
        "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}},
        "explanation": {"type": "string", "minLength": 1},
        "gloss": {"type": "string"},
        "notes": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}}
      }
    },
    "phraseOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrenceId", "blockId", "sourceSegments"],
      "properties": {
        "occurrenceId": {"$ref": "#/$defs/id"},
        "blockId": {"$ref": "#/$defs/id"},
        "sourceSegments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/segment"}
        },
        "semanticOverride": {"$ref": "#/$defs/phraseOverride"}
      }
    },
    "phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phraseId",
        "kind",
        "surface",
        "role",
        "labels",
        "explanation",
        "confidence",
        "occurrences"
      ],
      "properties": {
        "phraseId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["token", "phrase", "clause", "sentence", "discourse"]},
        "surface": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1, "maxLength": 60},
        "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}},
        "explanation": {"type": "string", "minLength": 1},
        "gloss": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"},
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/phraseOccurrence"}
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationId", "fromPhraseId", "toPhraseId", "type", "labels", "confidence"],
      "properties": {
        "relationId": {"$ref": "#/$defs/id"},
        "fromPhraseId": {"$ref": "#/$defs/id"},
        "toPhraseId": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}},
        "explanation": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockIds"],
      "properties": {
        "blockIds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "phraseId": {"$ref": "#/$defs/id"},
        "occurrenceIds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "grammarNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noteId", "scope", "explanation", "labels", "confidence"],
      "properties": {
        "noteId": {"$ref": "#/$defs/id"},
        "scope": {"$ref": "#/$defs/scope"},
        "explanation": {"type": "string", "minLength": 1},
        "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertaintyId", "scope", "kind", "message", "alternatives"],
      "properties": {
        "uncertaintyId": {"$ref": "#/$defs/id"},
        "scope": {"$ref": "#/$defs/scope"},
        "kind": {"enum": ["ambiguity", "translation", "syntax", "register", "cultural", "other"]},
        "message": {"type": "string", "minLength": 1},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
